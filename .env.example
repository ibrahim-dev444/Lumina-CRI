# Copy this file to .env and fill in your own values.
# .env is ignored by git. Never commit real passwords or keys.

# Postgres (used by docker-compose.yml and Django).
# Port 5433 avoids clashing with a PostgreSQL installed directly on Windows (5432).
POSTGRES_DB=lumina
POSTGRES_USER=lumina
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Fake FLEXCUBE source system (same Postgres server, separate database)
FLEXCUBE_DB_URL=postgresql://lumina:change-me-locally@localhost:5433/src_flexcube

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
